generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Self-maintaining master color map. Upserted on every Kelme pull:
// any new colorCode seen gets added, so the map grows with the catalog.
// colorCode is authoritative; colorName is the display value resolved from it.
model Color {
  colorCode  String  @id // e.g. "100", "416", "609"
  colorName  String // e.g. "White", "Dark Blue", "Wine Red"
  shopifyGid String? // color-pattern metaobject GID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// The sellable-size allow-list + GID source + capture gate. A size is
// sellable ONLY if it's in this table — capture drops any variant whose
// shopifySize isn't here, so phantom sizes can never re-enter.
model Size {
  shopifySize String  @id // "8", "M", "One Size", ... — only sellable sizes live here
  shopifyGid  String? // shopify--size metaobject GID (apparel-taxonomy only)
  ballSizeGid String? // shopify--ball-size metaobject GID — a DIFFERENT metaobject
  // definition than shopifyGid above. Shopify's shopify.size metafield is
  // taxonomy-scoped to apparel; ball products (Soccer Balls category) are
  // rejected outright if linked to it ("At least one value ... is invalid"),
  // confirmed live. A bare size like "4" is shared value-space between kids
  // apparel (shopifyGid) and balls (ballSizeGid) — same shopifySize row,
  // two different metaobject spaces, chosen by product category at
  // reconcile time (see lib/shopify-reconcile.ts).
  kind        String? // "kids" | "adult" | "onesize" | "ball"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Kelme product identity + product-level reference data.
// Written only by the Kelme capture, keyed on pdtid.
model Product {
  id    Int @id @default(autoincrement())
  pdtid Int @unique

  styleCode String
  name      String

  mainpic String @default("") // hero image URL (was imageUrl / mainpic)

  // Reference data — captured free from b2b.pdt.get, not used by the sync today,
  // kept for future pricing + category navigation. Do not remove.
  kelmeCatalogPrice Float? // catalog "price"
  kelmeFobCost      Float? // "Unit Price (Fob Xiamen)" — true landed cost
  categoryIds       String @default("") // m_dim*_id values, comma-joined

  // Structured attributes from b2b.pdt.detail (a separate, slower endpoint
  // from b2b.pdt.get above — its own sync timestamp). Gender is the field
  // this was built for (Kids/Adults tag classification); the rest are
  // captured now because the endpoint is already being paid for per-product,
  // kept for later use (navigation, shipping weight) rather than acted on
  // today. attributesRaw holds the full {title, value} list verbatim as a
  // safety net for anything not promoted to its own column.
  gender              String? // e.g. "Men", "Women", "Boys", "Girls", "Unisex"
  subCategory         String?
  collection          String?
  seasons             String?
  composition         String? // "Composition/Material"
  weightPerPiece      String? // "Weight/Piece" — raw string, unit unconfirmed
  function            String?
  topOrLower          String?
  kelmeDescription    String? // the "Description" attribute (distinct from `name`, which comes from b2b.pdt.get)
  attributesRaw       Json?
  attributesSyncedAt  DateTime? // last successful b2b.pdt.detail pull, separate from `syncedAt`

  syncedAt  DateTime? // last successful Kelme pull for this product
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Maintained by the relink step (lib/shopify-relink.ts): true if at least
  // one variant matched a live Shopify variant on the last reconcile, false
  // for favorites-only products with no live Shopify listing. Recomputed
  // every relink run, so it tracks products being added/removed on Shopify.
  onShopify Boolean @default(false)

  // The authoritative declaration of this product's shape, set by the Kelme
  // capture (colorCode / shopifySize references, natural-keyed against
  // Color/Size like Variant already is — no enforced FK). Variants are
  // DERIVED from colors × sizes (blank-filtered), not independently
  // maintained — this is the single source of truth for what a product is.
  colors String[] @default([])
  sizes  String[] @default([])

  variants Variant[]
}

// The core unit. One row per color × size that Kelme actually offers.
// Carries both the Kelme identity and the Shopify identity + the SKU join key.
model Variant {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  // Kelme identity
  colorCode   String // authoritative color key
  colorName   String // resolved from the Color map (denormalized for convenience)
  kelmeSize   String // raw Kelme size, e.g. "130cm", "M"
  shopifySize String // resolved Shopify-facing size, e.g. "8", "M"
  qty         Int    @default(0) // current Kelme stock (0 is valid and meaningful; not blank)
  imageUrl    String? // this color's image URL (by code), null if none exists

  // The join key — built by buildSku(styleCode, colorCode, shopifySize).
  sku String

  // Shopify identity — filled once matched/created on Shopify.
  shopifyVariantId       String? // target for SKU writes
  shopifyInventoryItemId String? // target for inventory pushes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, colorCode, shopifySize]) // one variant per color+size per product
  @@index([productId])
  @@index([sku])
}

// Singleton row (id fixed at 1) holding the Shopify Admin API access token
// for the single-store custom app. Token is AES-256-GCM encrypted at rest
// with SHOPIFY_TOKEN_ENCRYPTION_KEY (lib/shopify.ts) — never stored plain.
model ShopifyToken {
  id             Int      @id @default(1)
  encryptedToken String
  scope          String
  updatedAt      DateTime @updatedAt
}

// Singleton row (id fixed at 1) holding the Kelme B2B session token, shared
// between the app and the worker so a refreshed token persists across
// restarts instead of degrading (previously a static KELME_TOKEN env var).
// accessToken/refreshToken are AES-256-GCM encrypted at rest with the same
// key as ShopifyToken (lib/kelme.ts). "Time alive" is derived from
// obtainedAt, not stored. No "previous token" is kept — dead credentials
// have no use.
model KelmeToken {
  id              Int       @id @default(1)
  accessToken     String // encrypted at rest
  refreshToken    String? // encrypted at rest, if login returns one
  status          String    @default("alive") // "alive" | "dead" | "needs_reauth"
  obtainedAt      DateTime
  lastRefreshedAt DateTime
  // Set when the death-notification email has been sent for the CURRENT
  // dead spell — null means "not yet notified" (or "alive"). Set on the
  // alive->dead transition so the worker sends exactly one email per death
  // event instead of one every sync cycle; cleared back to null by the
  // re-auth flow's successful login (seedKelmeToken).
  deadNotifiedAt  DateTime?
  updatedAt       DateTime  @updatedAt
}

// Lifecycle/observability log for KelmeToken — metrics only, NEVER the token
// value itself. One row per token "life" (mint -> death), so real lifetime
// (diedAt - mintedAt) and whether refresh is actually firing (refreshCount,
// lastRefreshedAt) can be queried directly. At most one row has diedAt: null
// at a time — that's the current/open life.
model KelmeTokenHistory {
  id              Int       @id @default(autoincrement())
  mintedAt        DateTime
  diedAt          DateTime?
  deathReason     String? // "1009" | "000005" | "manual" | ...
  refreshCount    Int       @default(0)
  lastRefreshedAt DateTime?
  source          String // "captcha_reauth" | "manual_seed"
  createdAt       DateTime  @default(now())
}

// Singleton (id fixed at 1) recording when the worker last completed a full
// sync cycle without halting or throwing. The heartbeat check
// (app/api/cron/heartbeat) compares this against a staleness threshold to
// catch the worker being down/hung entirely — a failure mode that produces
// no error to alert on, only silence.
model SyncStatus {
  id                   Int       @id @default(1)
  lastSuccessfulSyncAt DateTime?
  updatedAt            DateTime  @updatedAt
}

// Dedup state for admin sync alerts (lib/admin-notify.ts), one row per alert
// kind ("sanity_halt" | "sync_failure" | "push_failures" | "stale_heartbeat").
// Mirrors KelmeToken.deadNotifiedAt's "send once per bad spell" pattern, but
// generalized: `active` tracks whether the kind is currently in a bad state,
// and lastNotifiedAt gates re-sending a reminder while it persists, instead
// of re-notifying every check/cycle.
model SyncAlert {
  kind           String    @id
  active         Boolean   @default(false)
  firstSeenAt    DateTime?
  lastNotifiedAt DateTime?
  updatedAt      DateTime  @updatedAt
}

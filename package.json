{
  "name": "kelme-team-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "kelme:seed-token": "node --env-file=.env scripts/seed-kelme-token.mjs",
    "db:studio": "prisma studio",
    "kelme-test": "node --env-file=.env kelme-token-test/index.js",
    "worker": "tsx worker/index.ts",
    "alert:test": "tsx --env-file=.env scripts/test-alert.mjs",
    "push:product": "tsx --env-file=.env scripts/push-product.ts",
    "test": "tsx --test tests/*.test.ts",
    "webhook:register": "tsx --env-file=.env scripts/register-orders-webhook.ts",
    "drafts": "tsx --env-file=.env scripts/drafts.ts",
    "shipping:weights": "tsx --env-file=.env scripts/shipping-weights.ts",
    "shipping:canary-weight": "tsx --env-file=.env scripts/shipping-canary-weight.ts",
    "shipping:rates": "tsx --env-file=.env scripts/shipping-rates.ts",
    "sizes": "tsx --env-file=.env scripts/sizes.ts",
    "colors": "tsx --env-file=.env scripts/colors.ts",
    "vendor-deletions": "tsx --env-file=.env scripts/vendor-deletions.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "16.3.2",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

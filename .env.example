DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

KELME_TOKEN=""
KELME_B2B_URL="http://gkemb2b.kelmechina.com:5020/svr/portal/servlets/binserv/B2B"
KELME_ORIGIN="http://gkemb2b.kelmechina.com:5020"

# Sent once per Kelme-session-death event (see lib/kelme-token.ts's
# markKelmeTokenDead / lib/vendor-notify.ts) — needs a Resend account with a
# verified sending domain matching RESEND_FROM.
RESEND_API_KEY=""
RESEND_FROM="Kelme Team <noreply@kelmeteam.com>"
KELME_VENDOR_EMAIL=""

ADMIN_PASSWORD=

# Shopify custom app (single store) — from the app's API credentials page.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SHOP="your-store.myshopify.com"
SHOPIFY_API_VERSION="2025-04"
# Base URL the OAuth redirect_uri is built from (must match an allowed
# redirect URL in the Shopify app config). Defaults to the request's own
# origin if unset — set this when testing behind ngrok or another tunnel.
SHOPIFY_APP_URL=""
# Random 32+ char secret used to encrypt the stored access token at rest.
SHOPIFY_TOKEN_ENCRYPTION_KEY=""

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

KELME_TOKEN=""
KELME_B2B_URL="http://gkemb2b.kelmechina.com:5020/svr/portal/servlets/binserv/B2B"
KELME_ORIGIN="http://gkemb2b.kelmechina.com:5020"

# Sent once per Kelme-session-death event (see lib/kelme-token.ts's
# markKelmeTokenDead / lib/vendor-notify.ts) — needs a Resend account with a
# verified sending domain matching RESEND_FROM.
RESEND_API_KEY=""
RESEND_FROM="Kelme Team <noreply@kelmeteam.com>"
# Also the recipient of each order's vendor sheet (lib/order-file-worker.ts);
# ADMIN_NOTIFY_EMAIL (below) is cc'd on it. Needed on Railway (the worker).
KELME_VENDOR_EMAIL=""

# Recipient for worker/heartbeat health alerts (halted syncs, cycle
# failures, systemic push failures, stale heartbeat) — see
# lib/admin-notify.ts. Required on Railway (the worker) as well as Vercel
# (the heartbeat cron route) — set in both, not just one, or that side's
# alerts silently no-op.
ADMIN_NOTIFY_EMAIL=""

ADMIN_PASSWORD=

# Shopify custom app (single store) — from the app's API credentials page.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET="" # also verifies orders/paid webhook HMACs (Vercel)
SHOPIFY_SHOP="your-store.myshopify.com"
# Optional override — leave unset to use DEFAULT_SHOPIFY_API_VERSION in
# lib/shopify.ts (the single source of truth). A value Shopify no longer
# supports is silently served as the oldest supported version.
# SHOPIFY_API_VERSION=""
# Base URL the OAuth redirect_uri is built from (must match an allowed
# redirect URL in the Shopify app config). Defaults to the request's own
# origin if unset — set this when testing behind ngrok or another tunnel.
SHOPIFY_APP_URL=""
# Random 32+ char secret used to encrypt the stored access token at rest.
SHOPIFY_TOKEN_ENCRYPTION_KEY=""

# Daily favorites -> Shopify drafts on the Railway worker (lib/auto-drafts.ts). Off unless exactly "true".
AUTO_DRAFTS_ENABLED="false"
# Max drafts created per daily run (default 15); the rest wait for the next run and the admin is alerted.
MAX_DRAFTS_PER_RUN="15"
